# Render supplies PORT automatically.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
JWT_SECRET=<generate-a-new-long-random-secret>
FRONTEND_URL=https://<your-vercel-app>.vercel.app

# Cloudinary
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>

# Gmail API OAuth delivery over HTTPS. Do not use SMTP variables.
GMAIL_USER=<your-gmail-address@gmail.com>
GMAIL_FROM=Multilingual Chat <your-gmail-address@gmail.com>
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
GOOGLE_REFRESH_TOKEN=<google-oauth-refresh-token>

# Used only when generating the refresh token locally.
# For a Render production OAuth callback, use:
# https://<your-render-service>.onrender.com/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
GOOGLE_REDIRECT_URI=https://chat-app-k29o.onrender.com/auth/google/callback
