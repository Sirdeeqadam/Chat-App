PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Optional: Gmail SMTP for OTP and password reset emails
NODE_CODE_SENDING_EMAIL_ADDRESS=your-gmail-address@gmail.com
NODE_CODE_SENDING_EMAIL_PASSWORD=your-gmail-app-password
HMAC_VERIFICATION_CODE_SECRET=replace-with-another-long-random-secret
